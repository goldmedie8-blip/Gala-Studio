{
  "name": "gala-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Gala Studio - an offline-first music studio for young producers and artists",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "test:lite": "vitest run --maxWorkers=1",
    "dev:phone": "vite --host --mode phone",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
